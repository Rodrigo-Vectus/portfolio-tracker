# ==========================================================================
# Portfolio Tracker — variables de entorno
# Copiar a .env y completar. NUNCA commitear el .env real.
#   cp .env.example .env && nano .env
# ==========================================================================

# --- Entorno -------------------------------------------------------------
APP_ENV=development           # development | production
APP_NAME=Portfolio Tracker
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Red -----------------------------------------------------------------
# Direccion a la que se bindean los puertos publicados por Docker.
# 0.0.0.0  -> accesible desde la red (necesario para probar desde tu notebook)
# 127.0.0.1 -> solo local, acceso via tunel SSH (recomendado en produccion)
BIND_ADDR=0.0.0.0
BACKEND_PORT=8210
FRONTEND_PORT=8211

# --- PostgreSQL ----------------------------------------------------------
# Postgres NO publica puertos al host. Solo es accesible desde la red Docker.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CAMBIAR_ESTA_PASSWORD
POSTGRES_DB=portfolio_tracker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Seguridad -----------------------------------------------------------
# Generar con: openssl rand -hex 32
SECRET_KEY=CAMBIAR_POR_UN_VALOR_ALEATORIO_DE_64_CARACTERES

# Origenes permitidos para el frontend (separados por coma).
CORS_ORIGINS=http://localhost:8211

# --- Administrador inicial (se usa recien en Fase 1) ---------------------
INITIAL_ADMIN_NAME=Rodrigo
INITIAL_ADMIN_EMAIL=rgonzalez@vectus.la
INITIAL_ADMIN_PASSWORD=CAMBIAR_ANTES_DE_LEVANTAR

# --- Preferencias de dominio (defaults, editables por usuario en F1) -----
DEFAULT_DISPLAY_CURRENCY=USD
DEFAULT_FX_SOURCE_EQUITY=MEP      # D1: dolar MEP como referencia para CEDEARs
DEFAULT_FX_SOURCE_CRYPTO=USDT     # D1: USDT como referencia para cripto
DEFAULT_COST_BASIS_METHOD=WAC     # D4: promedio ponderado sobre ledger de lotes
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# --- Frontend ------------------------------------------------------------
# Ruta base de la API vista desde el navegador. Vite proxea /api al backend.
VITE_API_BASE=/api
